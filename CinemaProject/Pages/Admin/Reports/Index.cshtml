@page
@model CinemaProject.Pages.Admin.Reports.ReportModel

<h2>Weekly Report Generator</h2>

<<div class="row mb-4">
    <div class="col-md-6">
        <form method="post" class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>
                </div>

                <button type="submit" asp-page-handler="Generate" class="btn btn-primary mt-3">
                    Generate and Save Report
                </button>
            </div>
        </form>

        <form method="post" asp-page-handler="DownloadPdf" class="mt-2">
            <button type="submit" class="btn btn-outline-secondary">
                📄 Download PDF
            </button>
        </form>
    </div>
</div>


@if (Model.CurrentReport != null)
{
    <div class="card mb-4">
        <div class="card-header">
            <h4>@Model.CurrentReport.ReportTitle</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Generated On:</dt>
                <dd class="col-sm-9">@Model.CurrentReport.GeneratedOn.ToString("f")</dd>

                <dt class="col-sm-3">Total Bookings:</dt>
                <dd class="col-sm-9">@Model.CurrentReport.TotalBookings</dd>

                <dt class="col-sm-3">Total Tickets Sold:</dt>
                <dd class="col-sm-9">@Model.CurrentReport.TotalTicketsSold</dd>

                <dt class="col-sm-3">Total Revenue:</dt>
                <dd class="col-sm-9">@Model.CurrentReport.TotalRevenue.ToString("C")</dd>
            </dl>
        </div>
    </div>
}

@if (Model.FilmStats.Any())
{
    <h4>Tickets Sold Per Film</h4>
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Film</th>
                <th>Tickets Sold</th>
                <th>Total Revenue</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.FilmStats)
            {
                <tr>
                    <td>@entry.Key</td>
                    <td>@entry.Value.TicketsSold</td>
                    <td>@entry.Value.Revenue.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

