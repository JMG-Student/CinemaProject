@page
@model CinemaProject.Pages.Customer.Home.IndexModel
@{
    bool isNextWeek = ViewData["IsNextWeek"] as bool? ?? false;
    string heading = isNextWeek ? "Next Weeks Screenings" : "This Weeks Screenings";
    string toggleButtonText = isNextWeek ? "Back to Current Week" : "Next Weeks Screenings";
}
<br />
<br />
<br />

<div class="row container pb-3 backgroundWhite">
    <div class="row container pb-3 backgroundWhite">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 style="text-align: center; color:white">@heading</h2>
            <a asp-page="./Index" asp-route-IsNextWeek="@(!isNextWeek)" class="btn btn-primary">@toggleButtonText</a>
        </div>
    @if (!string.IsNullOrEmpty(Model.SearchString) && !Model.listOfFilms.Any(film => film.Title.Contains(Model.SearchString, StringComparison.OrdinalIgnoreCase)))
    {
        <div style="text-align: center; margin-top: 10px; color:white">
            <h3>
                <br />
                There are no Screenings for "<span style="color: white;">@Model.SearchString</span>"
            </h3>
        </div>
    }

        <body class="bg-light text-white">
            <div class="container py-5">
                <h1 class="text-primary">Welcome to CineBook</h1>
                <button class="btn btn-primary">Buy Tickets</button>
                <div class="alert alert-danger mt-3">Seats are limited!</div>
            </div>
        </body>




    <div class="film-grid">
        @foreach (var film in Model.listOfFilms)
        {
            //movie poster
            <div class="film-item">
                <div class="card bg-white rounded shadow-sm" style="border:1px solid #222; transition: transform 0.2s; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#descriptionModal-@film.Id">
                    <div class="card-img-container">
                        <img class="card-img-top img-fluid" src="@film.PosterLink" alt="@film.Title" style="width: 100%; height: 100%;" />
                    </div>
                </div>
            </div>
            //popup
            <div class="modal fade" id="descriptionModal-@film.Id" tabindex="-1" aria-labelledby="descriptionModalLabel-@film.Id" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h4 class="modal-title" id="descriptionModalLabel-@film.Id">@film.Title</h4>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        @* model body *@
                        <div class="row">
                            <div class="col-md-5">
                                <div class="row">
                                    <div class="modal-body text-align: left" >
                                        <p><strong>Genre:</strong> <br /> @film.Genre.Name</p>
                                            <p><strong>Film Length:</strong> <br /> @film.Runtime minutes</p>
                                            <p><strong>Description:</strong> <br />  "@film.Description"</p>
                              
                                  </div>
                                  <div class="row">
                                    <div class="modal-body text-center">
                                        @if (!string.IsNullOrEmpty(film.TrailerLink))
                                        {
                                            <div class="embed-responsive embed-responsive-16by9 mb-4">
                                                <iframe class="embed-responsive-item"
                                                        width="100%"
                                                        height="50%"
                                                        src="@film.TrailerLink?rel=0&autoplay=0"
                                                        allowfullscreen>
                                                </iframe>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-muted">No trailer available.</p>
                                        }
                                     </div>
                                    </div>
                                </div>
                           </div>
                            <div class="col-md-6 text-center">

                            <h4>Screenings @(isNextWeek ? "Next Week" : "This Week")</h4>
                            @{
                                var currentDate = DateTime.Now;
                                var weekStart = isNextWeek ? currentDate.AddDays(7 - (int)currentDate.DayOfWeek) : currentDate.AddDays(-(int)currentDate.DayOfWeek);
                                var weekEnd = weekStart.AddDays(7);
                                var screenings = film.Screenings
                                .Where(s => s.Time >= weekStart && s.Time < weekEnd)
                                .OrderBy(s => s.Time)
                                .ToList();
                            }
                            @if (screenings.Any())
                                {
                                    <table class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Start Time</th>
                                                <th>End Time</th>
                                                <th>Screen</th>
                                                <th>Book Tickets</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var screening in screenings)
                                            {
                                                var endTime = screening.Time.AddMinutes(film.Runtime);
                                                <tr>
                                                    <td>@screening.Time.ToString("D")</td>
                                                    <td>@screening.Time.ToString("t")</td>
                                                    <td>@endTime.ToString("t")</td>
                                                    <td>@screening.ScreenID</td>
                                                    <td>
                                                        <a asp-page="/Customer/Bookings/Create" asp-route-Id="@screening.Id" class="btn btn-primary">Book Tickets</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <p>No screenings found for this week.</p>
                                }
                            </div>
                               
                         </div>
                        
                        
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .film-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: flex-start;
    }

    .film-item {
        width: 21%;
        margin: 0;
        padding: 0;
    }

    .card:hover {
        transform: scale(1.05);
    }

    .card-img-container {
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        overflow: hidden;
        height: 400px;
    }

    .card-body {
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    footer {
        position: static !important;
    }

    .modal-content {
        color: white; 
    }
    .modal-title {
        text-align: center;
        width: 100%; 
    }

    @@media (max-width: 1200px) {
        .film-item {
            width: 29%;
        }
    }

    @@media (max-width: 768px) {
        .film-item {
            width: 46%;
        }
    }

    @@media (max-width: 576px) {
        .film-item {
            width: 100%;
        }
    }
</style>