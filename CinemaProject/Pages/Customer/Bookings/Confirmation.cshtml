@page
@model CinemaProject.Pages.Customer.Bookings.ConfirmationModel
@{
}
<div class="container p-3 text-white">
    <div class="row pt-4">
        <div class="col-6">
        </div>
        <div class="col-6">
        </div>
    </div>


    <h2>Thank you, @Model.booking.CustomerName</h2>
    <h4>An email has been sent to @Model.booking.CustomerEmail</h4>
    <h4>Your booking ID is @Model.booking.Id</h4>
    <br />
    <h4>Film: @Model.film.Title</h4>
    <h4>Time: @Model.screening.Time.ToString()</h4>
    <h4>Screen: @Model.screening.ScreenID </h4>
    <br />
    <br />
    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Ticket Type</th>
                <th>Count</th>
                <th>Price</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var obj in Model.tickets)
            {
                @if (obj.Count >= 1)
                {
                    <tr>
                        <td width="15%">@obj.Type.Name</td>
                        <td width="15%">@obj.Count</td>
                        <td width="15%">@obj.Type.Price</td>
                        <td width="15%">@obj.TotalPrice</td>
                    </tr>
                }
            }
            <tr>
                <td width="15%"></td>
                <td width="15%"></td>
                <td width="15%"></td>
                <td width="15%">@Model.booking.TotalPrice.ToString("F2")</td>
            </tr>
        </tbody>
    </table>
</div>