@page
@model CinemaProject.Pages.Customer.Bookings.CreateModel
@{
}

<style>
    .input-narrow {
        max-width: 100px;
    }

    .input-wide {
        max-width: 200px;
    }
</style>

<form method="post">
    <div class="container mt-4">
        <div class="row pb-3">
            <h2 class="text-primary">Booking for @Model.Film.Title at @Model.Screening.Time</h2>
        </div>

        <div class="row">
            <div class="col-md-4 text-center">
                <img src="@Model.Film.PosterLink" alt="Film Poster" class="img-fluid rounded shadow" />
                <p class="mt-3"></p>

            </div>

            @* Form column *@

            <div class="col-md-5 text-center">
                <input asp-for="@Model.ScreeningId" type="number" hidden />

              <h4 class="mt-3">Currently <strong>@Model.availableSeats</strong> seats left</h4>
                @for (int i = 0; i < Model.TicketTypeList.Count; i++)
                {
                    <div class="text-center mb-3">
                        <label asp-for="@Model.ticketQuantities[i]" class="form-label">@Model.TicketTypeList[i].Name</label>
                        <div class="d-flex justify-content-center">
                            <input asp-for="@Model.ticketQuantities[i]" type="number" class="form-control input-narrow" min="0" required />
                        </div>
                        <span asp-validation-for="@Model.ticketQuantities[i]" class="text-danger"></span>
                    </div>
                }

                <div class="col-md-5 text-center mx-auto">
                    <label asp-for="@Model.Booking.CustomerEmail" class="form-label">Email address</label>
                    <div class="d-flex justify-content-center">
                        <input asp-for="@Model.Booking.CustomerEmail" type="email" class="form-control input-wide" required />
                    </div>
                    <span asp-validation-for="@Model.Booking.CustomerEmail" class="text-danger"></span>
                </div>

                <div class="col-md-5 text-center mx-auto mt-3">
                    <label asp-for="@Model.Booking.CustomerName" class="form-label">Full Name</label>
                    <div class="d-flex justify-content-center">
                        <input asp-for="@Model.Booking.CustomerName" type="text" class="form-control input-wide" required />
                    </div>
                    <span asp-validation-for="@Model.Booking.CustomerName" class="text-danger"></span>
                </div>

                <div class="mb-3 text-center mt-4">
                    <a asp-page="../Home/Index" class="btn btn-secondary me-2">Home</a>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#paymentModal">
                        Proceed to Payment
                    </button>
                </div>

        </div>
    </div>

    @if (Model.NotEnoughSeats)
    {
            <div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title text-danger">Not enough Seats Available</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center">
                            <p>Not enough seats left for this screening.</p>
                            <p>There are only <strong>@Model.availableSeats</strong> seats remaining.</p>
                            <a asp-page="../Home/Index" class="btn btn-secondary">Back to Home</a>
                        </div>
                    </div>
                </div>
            </div>
    }
    else
    {
            <div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Enter Card Details</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center ">
                            <input type="hidden" asp-for="ScreeningId" />

                            <div class="mb-3">
                                <label asp-for="CardHolderName" class="form-label">Card Holder's Name</label>
                                <div class="d-flex justify-content-center">
                                <input asp-for="CardHolderName" class="form-control input-wide" required />
                                </div>
                                <span asp-validation-for="CardHolderName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CardNumber" class="form-label">Card Number</label>
                                <div class="d-flex justify-content-center">
                                <input asp-for="CardNumber" class="form-control input-wide" required />
                                </div>
                                <span asp-validation-for="CardNumber" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="CCV" class="form-label">CCV</label>
                                <div class="d-flex justify-content-center">
                                <input asp-for="CCV" class="form-control input-narrow" required />
                                </div>
                                <span asp-validation-for="CCV" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ExpirationDate" class="form-label">Expiration Date (MM/YYYY)</label>
                                <div class="d-flex justify-content-center">
                                <input asp-for="ExpirationDate" class="form-control input-narrow" required />
                                </div>
                                <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-success">Confirm Payment</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    }
</form>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}
